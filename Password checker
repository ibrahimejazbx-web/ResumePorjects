password = input("Enter your password: ")

def check_length(password):
    if len(password) >= 8:
        return True
    else:
        return False
def check_no_spaces(password):
    if " " not in password:
        return True
    else:
        return False
def check_uppercase(password):
    if any(char.isupper() for char in password):
        return True
    else:
        return False
def check_lowercase(password):
    if any(char.islower() for char in password):
        return True
    else:
        return False
def check_digits(password):
    if any(char.isdigit() for char in password):
        return True
    else:
        return False
def check_special_char(password):
    if not password.isalnum():
        return True
    else:
        return False
    

def evaluate_password(password):
    score = 0
    issues = []
    if check_length(password):
        score += 1
    else:
        issues.append("password must contain at least 8 characters")

    if check_no_spaces(password):
        score += 1
    else:
        issues.append("Password must NOT contain spaces")

    if check_uppercase(password):
        score += 1
    else:
        issues.append("Password must contain an uppercase letter")

    if check_lowercase(password):
        score += 1
    else:
        issues.append("Password must contain an lowercase letter")

    if check_digits(password):
        score += 1
    else:
        issues.append("Password must contain numeric digits")

    if check_special_char(password):
        score += 1
    else:
        issues.append("Password must contain special characters")
    return score, issues

def get_strength(score):
    if score <= 2:
        return "Weak"
    elif 2 <= score <= 4:
        return "Moderate"
    else:
        return "Strong"

score, issues = evaluate_password(password)
print("Issues: ", issues)
print("Score: ", score)
strength  = get_strength(score)
print("Strength: ", strength)




